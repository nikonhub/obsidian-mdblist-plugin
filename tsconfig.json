{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2021",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"lib": ["DOM", "ES2021"],
		"types": ["node"]
	},
	"include": ["src/**/*.ts"]
}
